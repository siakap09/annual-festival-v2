NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never prefix with NEXT_PUBLIC_. Used to send section-access
# invite emails via supabase.auth.admin.inviteUserByEmail. Find it in
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to email each student's check-in QR code to their parent, over real
# SMTP (see lib/email.ts). For Gmail: enable 2-Step Verification on the
# sending account, then create an App Password at
# https://myaccount.google.com/apppasswords -- use that here, not the
# regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=Festival
