NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never prefix with NEXT_PUBLIC_. Used to send section-access
# invite emails via supabase.auth.admin.inviteUserByEmail. Find it in
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to email each student's check-in QR code to their parent (Resend
# REST API, see lib/email.ts). Get an API key from https://resend.com and
# verify a sending domain there first.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Festival <noreply@yourdomain.com>"
